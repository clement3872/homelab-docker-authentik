# Authentik — Caddyfile snippet
# Import into your main Caddyfile:
#   import /path/to/authentik.caddy
#
# Assumes:
#   - Authentik server is on the same host, listening on 127.0.0.1:9000
#   - TLS cert issued by Caddy (ACME / internal CA)
#   - VPS upstream does SNI passthrough, so TLS terminates here

auth.example.com {
    # Pass real client IP through the VPS/nginx proxy
    # Adjust the trusted_proxies range to match your VPS
    trusted_proxies static <VPS_IP>/32

    reverse_proxy 127.0.0.1:9000 {
        # Authentik needs the original Host header
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
