# -------------------------------------------------------
# Authentik — environment variables
# Copy to .env and fill in the values (run generate-secrets.sh)
# -------------------------------------------------------

# ── Database ─────────────────────────────────────────────
PG_PASS=        # required — generate with: openssl rand -base64 36
PG_USER=authentik
PG_DB=authentik

# ── Authentik core ───────────────────────────────────────
AUTHENTIK_SECRET_KEY=   # required — generate with: openssl rand -base64 60

# ── Image version ────────────────────────────────────────
# Check https://github.com/goauthentik/authentik/releases
AUTHENTIK_TAG=2026.8.5

# ── Networking ───────────────────────────────────────────
# Port Caddy will hit on localhost
AUTHENTIK_PORT=9000

# ── Email (optional — needed for password resets / notifications) ──
# AUTHENTIK_EMAIL__HOST=smtp.example.com
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=
# AUTHENTIK_EMAIL__PASSWORD=
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__FROM=authentik@example.com

# ── Miscellaneous ────────────────────────────────────────
# Set to false for self-hosted privacy
AUTHENTIK_ERROR_REPORTING__ENABLED=false
# debug | info | warning | error
AUTHENTIK_LOG_LEVEL=info
